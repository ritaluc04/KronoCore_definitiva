# Copia este archivo a .env y ajusta valores (Docker Compose lee variables del entorno).
# En Windows PowerShell:  Copy-Item .env.example .env

POSTGRES_HOST=192.168.0.251
POSTGRES_PORT=25060
POSTGRES_DB=kronocore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_contraseña

# Perfil Spring al arrancar el backend con PostgreSQL
SPRING_PROFILES_ACTIVE=postgres

# SMTP (opcional, igual que en application.properties)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

FRONTEND_CONFIRMATION_URL=http://localhost:5500/login/login.html
